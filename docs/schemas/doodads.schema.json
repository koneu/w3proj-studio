{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doodads (map/war3map.doo.json)",
  "description": "The project form of war3map.doo (doodads and destructables), written by the format definition crates/w3proj/formats/doodads.json. Keys the definition doesn't know are allowed: the codec ignores them (they don't reach the packed map). A split terrain's per-subterrain doodads.json has the same format tag but another shape; this schema is not for it.",
  "type": "object",
  "required": ["format", "magic", "version", "subversion", "doodads", "specialVersion", "specials"],
  "properties": {
    "format": { "const": "w3proj.doodads/1" },
    "magic": { "$ref": "#/$defs/id", "description": "\"W3do\"" },
    "version": { "description": "7 Reign of Chaos, 8 The Frozen Throne to Reforged, 12 and 13 the 3.0 editor", "enum": [7, 8, 12, 13] },
    "subversion": { "$ref": "#/$defs/u32" },
    "skinIds": { "$ref": "#/$defs/variant", "description": "version 8: whether each doodad has a skinId (Reforged). Missing means false." },
    "doodads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "variation", "position", "angle", "scale", "flags", "life", "editorId"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "variation": { "$ref": "#/$defs/u32" },
          "position": { "type": "array", "items": { "$ref": "#/$defs/f32" }, "minItems": 3, "maxItems": 3 },
          "angle": { "$ref": "#/$defs/f32", "description": "radians" },
          "scale": { "type": "array", "items": { "$ref": "#/$defs/f32" }, "minItems": 3, "maxItems": 3 },
          "skinId": { "$ref": "#/$defs/id", "description": "version 12 and 13, and version 8 with skinIds" },
          "preFlags": { "$ref": "#/$defs/u32", "description": "version 12 and 13" },
          "flags": { "$ref": "#/$defs/u8", "description": "bit 0 outside the playable map, bit 1 visible, bit 2 fixed z, bit 3 scale along the model's axes" },
          "life": { "$ref": "#/$defs/u8", "description": "percent" },
          "itemTable": { "$ref": "#/$defs/i32", "description": "version 8 and later: map item table index, -1 none" },
          "itemSets": {
            "description": "version 8 and later",
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "chance"],
                "properties": {
                  "id": { "$ref": "#/$defs/id" },
                  "chance": { "$ref": "#/$defs/u32" }
                }
              }
            }
          },
          "editorId": { "$ref": "#/$defs/u32" },
          "trailer": { "type": "array", "items": { "$ref": "#/$defs/u32" }, "minItems": 2, "maxItems": 3, "description": "version 12: two numbers; version 13: the placement id, Roll and Pitch (f32 radians, stored as their bits)" },
          "extras": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/$defs/u32" }, "minItems": 9, "maxItems": 9 }, "description": "version 12 and 13: the doodad's lights, nine numbers each" }
        }
      }
    },
    "specialVersion": { "$ref": "#/$defs/u32" },
    "specials": {
      "description": "terrain doodads (cliffs, ramps)",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "z", "x", "y"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "z": { "$ref": "#/$defs/u32" },
          "x": { "$ref": "#/$defs/u32" },
          "y": { "$ref": "#/$defs/u32" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["version"], "properties": { "version": { "minimum": 8 } } },
      "then": { "properties": { "doodads": { "items": { "required": ["itemTable", "itemSets"] } } } }
    },
    {
      "if": { "required": ["version"], "properties": { "version": { "minimum": 12 } } },
      "then": { "properties": { "doodads": { "items": { "required": ["skinId", "preFlags", "trailer", "extras"] } } } }
    },
    {
      "if": { "required": ["version", "skinIds"], "properties": { "version": { "const": 8 }, "skinIds": { "const": true } } },
      "then": { "properties": { "doodads": { "items": { "required": ["skinId"] } } } }
    },
    {
      "if": { "required": ["version"], "properties": { "version": { "const": 12 } } },
      "then": { "properties": { "doodads": { "items": { "properties": { "trailer": { "maxItems": 2 } } } } } }
    },
    {
      "if": { "required": ["version"], "properties": { "version": { "const": 13 } } },
      "then": { "properties": { "doodads": { "items": { "properties": { "trailer": { "minItems": 3 } } } } } }
    }
  ],
  "$defs": {
    "u8": { "type": "integer", "minimum": 0, "maximum": 255 },
    "u16": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "u32": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "i32": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
    "f32": {
      "description": "a 32-bit float: a number, or \"f32:0x\" and its 8 hex digits (NaN and infinities keep their bits that way)",
      "anyOf": [
        { "type": "number", "exclusiveMinimum": -3.4028235677973366e38, "exclusiveMaximum": 3.4028235677973366e38 },
        { "type": "string", "pattern": "^f32:0x[0-9a-fA-F]{8}$" }
      ]
    },
    "cstring": { "description": "a zero-terminated string; it can't hold the zero character", "type": "string", "pattern": "^[^\\u0000]*$" },
    "char": { "description": "one printable ASCII character, or empty for a zero byte", "type": "string", "pattern": "^[!-~]?$" },
    "id": { "description": "four bytes: four printable ASCII characters (\"hfoo\"), or \"0x\" and 8 hex digits", "type": "string", "pattern": "^(0x[0-9a-fA-F]{8}|[ -~]{4})$" },
    "rgba": { "type": "array", "items": { "$ref": "#/$defs/u8" }, "minItems": 4, "maxItems": 4 },
    "variant": { "description": "a layout choice the codec made reading the file; it stores no bytes", "type": "boolean" }
  }
}
