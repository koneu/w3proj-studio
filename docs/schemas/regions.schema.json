{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Regions (map/war3map.w3r.json)",
  "description": "The project form of war3map.w3r, written by the format definition crates/w3proj/formats/regions.json. Keys the definition doesn't know are allowed: the codec ignores them (they don't reach the packed map).",
  "type": "object",
  "required": ["format", "version", "regions"],
  "properties": {
    "format": { "const": "w3proj.regions/1" },
    "version": { "description": "5 classic and Reforged, 7 the 3.0 editor", "enum": [5, 7] },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["left", "bottom", "right", "top", "name", "index", "weather", "sound", "color"],
        "properties": {
          "left": { "$ref": "#/$defs/f32" },
          "bottom": { "$ref": "#/$defs/f32" },
          "right": { "$ref": "#/$defs/f32" },
          "top": { "$ref": "#/$defs/f32" },
          "name": { "$ref": "#/$defs/cstring" },
          "index": { "$ref": "#/$defs/u32", "description": "creation number; triggers refer to gg_rct_<name>" },
          "weather": { "$ref": "#/$defs/id", "description": "weather effect id (e.g. RAlr), 0x00000000 for none" },
          "sound": { "$ref": "#/$defs/cstring", "description": "ambient sound (a sound variable name), empty for none" },
          "color": {
            "type": "object",
            "required": ["blue", "green", "red"],
            "properties": {
              "blue": { "$ref": "#/$defs/u8" },
              "green": { "$ref": "#/$defs/u8" },
              "red": { "$ref": "#/$defs/u8" },
              "alpha": { "$ref": "#/$defs/u8", "description": "255 when missing" }
            }
          },
          "trailer": { "type": "array", "items": { "$ref": "#/$defs/u32" }, "minItems": 2, "maxItems": 2, "description": "version 7; zero in all samples" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["version"], "properties": { "version": { "const": 7 } } },
      "then": { "properties": { "regions": { "items": { "required": ["trailer"] } } } }
    }
  ],
  "$defs": {
    "u8": { "type": "integer", "minimum": 0, "maximum": 255 },
    "u16": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "u32": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "i32": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
    "f32": {
      "description": "a 32-bit float: a number, or \"f32:0x\" and its 8 hex digits (NaN and infinities keep their bits that way)",
      "anyOf": [
        { "type": "number", "exclusiveMinimum": -3.4028235677973366e38, "exclusiveMaximum": 3.4028235677973366e38 },
        { "type": "string", "pattern": "^f32:0x[0-9a-fA-F]{8}$" }
      ]
    },
    "cstring": { "description": "a zero-terminated string; it can't hold the zero character", "type": "string", "pattern": "^[^\\u0000]*$" },
    "char": { "description": "one printable ASCII character, or empty for a zero byte", "type": "string", "pattern": "^[!-~]?$" },
    "id": { "description": "four bytes: four printable ASCII characters (\"hfoo\"), or \"0x\" and 8 hex digits", "type": "string", "pattern": "^(0x[0-9a-fA-F]{8}|[ -~]{4})$" },
    "rgba": { "type": "array", "items": { "$ref": "#/$defs/u8" }, "minItems": 4, "maxItems": 4 },
    "variant": { "description": "a layout choice the codec made reading the file; it stores no bytes", "type": "boolean" }
  }
}
