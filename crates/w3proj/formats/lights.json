// war3map.w3l — the map's own day/night lighting from the lighting editor (World Editor 3.0.1).
// The editor saves edited lighting as models in the map ("<guid>.mdl", copies of the game's DNC
// light models, e.g. Model "DNCLordaeronTerrain" with its light "FDirectSun"; listed in
// war3map.imp) and names them here: one for the terrain, one for units. Every map saved by that
// editor has the file; without edits the names are empty and the numbers 0. Worked out from
// light_map.w3m saved with terrain lighting only (1, 0, 0), with both (1, 1, 0), and maps
// without (0, 0, 0).
{
  "name": "lights",
  "description": "Lighting: the map's own terrain and unit light models (lighting editor)",
  "files": ["war3map.w3l"],
  "jsonFormat": "w3proj.lights/1",
  "accept": "version == 3",
  "fields": [
    { "name": "magic", "type": "id", "doc": "\"W3L!\"" },
    { "name": "version", "type": "u32" },
    { "name": "terrainModel", "type": "cstring", "doc": "the edited terrain lighting model in the map, empty for the tileset's" },
    { "name": "unitModel", "type": "cstring", "doc": "the edited unit lighting model in the map, empty for the tileset's" },
    { "name": "terrainEnabled", "type": "u32", "doc": "1 when the terrain uses terrainModel" },
    { "name": "unitEnabled", "type": "u32", "doc": "1 when units use unitModel" },
    { "name": "unknown", "type": "u32", "doc": "0 in all samples" }
  ]
}
