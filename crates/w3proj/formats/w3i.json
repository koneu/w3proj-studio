// war3map.w3i — map info. Versions 25 (The Frozen Throne) to 39 (3.0).
// Sources: WC3MapSpecification, War3Net, wc3libs "warcraft-iii-3.0-map-formats";
// v39 verified byte-exact against the game's own 3.0 campaign maps.
{
  "name": "w3i",
  "description": "Map info: name, author, players, forces, options, fog, loading screen",
  "files": ["war3map.w3i"],
  "jsonFormat": "w3proj.mapinfo/1",
  "accept": "version >= 25 && version <= 39",
  "fields": [
    { "name": "version", "type": "u32" },
    { "name": "saves", "type": "u32" },
    { "name": "editorVersion", "type": "u32" },
    { "name": "gameVersion", "type": "u32", "count": 4, "if": "version >= 27", "doc": "major, minor, patch, build" },
    { "name": "name", "type": "cstring" },
    { "name": "author", "type": "cstring" },
    { "name": "description", "type": "cstring" },
    { "name": "suggestedPlayers", "type": "cstring" },
    { "name": "cameraBounds", "type": "f32", "count": 8 },
    { "name": "cameraComplements", "type": "u32", "count": 4 },
    { "name": "playableWidth", "type": "u32" },
    { "name": "playableHeight", "type": "u32" },
    { "name": "flags", "type": "u32" },
    { "name": "tileset", "type": "char" },
    { "name": "loadingScreen", "type": "struct", "fields": [
      { "name": "number", "type": "i32", "doc": "-1 = none / custom model" },
      { "name": "crestRace", "type": "u32", "if": "version >= 39" },
      { "name": "model", "type": "cstring" },
      { "name": "text", "type": "cstring" },
      { "name": "title", "type": "cstring" },
      { "name": "subtitle", "type": "cstring" }
    ] },
    { "name": "gameDataSet", "type": "u32" },
    { "name": "prologue", "type": "struct", "fields": [
      { "name": "path", "type": "cstring" },
      { "name": "text", "type": "cstring" },
      { "name": "title", "type": "cstring" },
      { "name": "subtitle", "type": "cstring" }
    ] },
    { "name": "fog", "type": "struct", "fields": [
      { "name": "style", "type": "u32" },
      { "name": "start", "type": "f32" },
      { "name": "end", "type": "f32" },
      { "name": "density", "type": "f32" },
      { "name": "color", "type": "rgba" }
    ] },
    { "name": "terrainFog", "type": "struct", "if": "version >= 39", "fields": [
      { "name": "style", "type": "i32" },
      { "name": "overSky", "type": "i32" },
      { "name": "linearStart", "type": "f32" },
      { "name": "linearEnd", "type": "f32" },
      { "name": "maxOpacity", "type": "f32" },
      { "name": "height", "type": "f32" }
    ] },
    { "name": "weather", "type": "id" },
    { "name": "soundEnvironment", "type": "cstring" },
    { "name": "lightEnvironment", "type": "char" },
    { "name": "waterTint", "type": "rgba" },
    { "name": "scriptType", "type": "u32", "if": "version >= 28", "doc": "0 JASS, 1 Lua" },
    { "name": "supportedModes", "type": "u32", "if": "version >= 31" },
    { "name": "gameDataVersion", "type": "u32", "if": "version >= 31" },
    { "name": "cameraZoom", "type": "struct", "if": "version >= 32", "fields": [
      { "name": "default", "type": "i32" },
      { "name": "max", "type": "i32" },
      { "name": "min", "type": "i32", "if": "version >= 33" }
    ] },
    { "name": "water", "type": "struct", "if": "version >= 39", "fields": [
      { "name": "minOpacity", "type": "i32" },
      { "name": "maxOpacity", "type": "i32" },
      { "name": "reflectivity", "type": "i32" },
      { "name": "emissivity", "type": "i32" },
      { "name": "edgeSoftness", "type": "i32" },
      { "name": "wavesVertexDisplacement", "type": "i32" },
      { "name": "wavesNormalMapStrength", "type": "i32" },
      { "name": "overrideColor", "type": "i32" },
      { "name": "environmentMapReflectivity", "type": "i32" },
      { "name": "unknown", "type": "i32" }
    ] },
    // Not documented anywhere: v39 files from editor builds before ~6128 have no
    // per-player HUD skin, later builds do. Both readings are tried; the
    // `fixedStart` check (small flag values) rejects the misaligned one.
    { "name": "playerHudSkins", "type": "variant", "if": "version >= 39", "prefer": "editorVersion >= 6128" },
    { "name": "players", "type": "struct", "count": "u32", "fields": [
      { "name": "id", "type": "u32", "check": "value < 28" },
      { "name": "controller", "type": "u32", "doc": "1 user, 2 computer, 3 neutral, 4 rescuable", "check": "value <= 4" },
      { "name": "race", "type": "u32", "doc": "0 selectable, 1 human, 2 orc, 3 undead, 4 night elf", "check": "value <= 4" },
      { "name": "hudSkin", "type": "u32", "if": "version >= 39 && playerHudSkins", "default": 0 },
      { "name": "fixedStart", "type": "u32", "check": "value <= 3", "doc": "flag bits; bit 0 = fixed start position (values 0-3 seen)" },
      { "name": "name", "type": "cstring" },
      { "name": "start", "type": "f32", "count": 2 },
      { "name": "allyLow", "type": "u32" },
      { "name": "allyHigh", "type": "u32" },
      { "name": "enemyLow", "type": "u32", "if": "version >= 31", "default": 0 },
      { "name": "enemyHigh", "type": "u32", "if": "version >= 31", "default": 0 }
    ] },
    { "name": "forces", "type": "struct", "count": "u32", "fields": [
      { "name": "flags", "type": "u32" },
      { "name": "players", "type": "u32", "doc": "bit mask of member players" },
      { "name": "name", "type": "cstring" }
    ] },
    { "name": "upgrades", "type": "struct", "count": "u32", "fields": [
      { "name": "players", "type": "u32" },
      { "name": "id", "type": "id" },
      { "name": "level", "type": "u32" },
      { "name": "availability", "type": "u32" }
    ] },
    { "name": "techs", "type": "struct", "count": "u32", "fields": [
      { "name": "players", "type": "u32" },
      { "name": "id", "type": "id" }
    ] },
    { "name": "unitTables", "type": "struct", "count": "u32", "fields": [
      { "name": "number", "type": "u32" },
      { "name": "name", "type": "cstring" },
      { "name": "positions", "type": "i32", "count": "u32" },
      { "name": "lines", "type": "struct", "count": "u32", "fields": [
        { "name": "chance", "type": "u32" },
        { "name": "ids", "type": "id", "count": "len(positions)" }
      ] }
    ] },
    { "name": "itemTables", "type": "struct", "count": "u32", "fields": [
      { "name": "number", "type": "u32" },
      { "name": "name", "type": "cstring" },
      { "name": "sets", "type": "list", "count": "u32", "item":
        { "type": "struct", "count": "u32", "fields": [
          { "name": "chance", "type": "u32" },
          { "name": "id", "type": "id" }
        ] } }
    ] }
  ]
}
