{
  "id": "w3.terrainMapSize",
  "name": "Map Size and Camera Bounds",
  "version": "0.1.0",
  "description": "Map Size and Camera Bounds, a tab of its own (not in the terrain viewer's toolbar): grow or shrink the map per side and set the unplayable border (camera bounds), with a preview on the map, like the World Editor's Map Size and Camera Bounds.",
  "activationEvents": ["onEditor:w3.terrainViewer", "onCommand:w3.terrainMapSize.edit", "onEditor:w3.terrainMapSize"],
  "extensionDependencies": ["w3.terrainViewer"],
  "contributes": {
    "editors": [{ "id": "w3.terrainMapSize", "title": "Map Size", "patterns": ["w3:terrain-mapsize"] }],
    "commands": [
      { "id": "w3.terrainMapSize.edit", "when": "project", "title": "Map Size and Camera Bounds", "category": "Terrain" },
      { "id": "w3.terrainMapSize.undo", "when": "project", "title": "Undo Resize", "category": "Terrain" },
      { "id": "w3.terrainMapSize.redo", "when": "project", "title": "Redo Resize", "category": "Terrain" }
    ]
  }
}
