{
  "id": "w3.explorer",
  "name": "Explorer",
  "version": "0.1.0",
  "description": "File tree of the open map project: open, new file, rename (F2), delete (Del), copy path, reveal in File Explorer (right-click).",
  "activationEvents": ["onStartup"],
  "contributes": {
    "viewContainers": [{ "id": "explorer", "title": "Explorer", "icon": "▤", "order": 0 }],
    "views": [{ "id": "w3.explorer.files", "title": "Project", "container": "explorer" }],
    "commands": [
      { "id": "w3.explorer.refresh", "title": "Refresh Explorer", "category": "Explorer" },
      { "id": "w3.explorer.newFile", "title": "New File…", "category": "Explorer" },
      { "id": "w3.explorer.collapseAll", "title": "Collapse All", "category": "Explorer" },
      { "id": "w3.explorer.focus", "title": "Show Explorer", "category": "View", "keybinding": "ctrl+shift+e" }
    ]
  }
}
