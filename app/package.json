{
  "name": "w3proj-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/check-imports.mjs && vite build",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.headless.json && node scripts/check-imports.mjs && node scripts/check-keys.mjs && node scripts/check-scripts.mjs",
    "test": "node scripts/test.mjs",
    "coverage": "node scripts/coverage.mjs",
    "ui-smoke": "node scripts/ui-smoke.mjs",
    "app-smoke": "node scripts/app-smoke.mjs",
    "tauri": "tauri",
    "icon": "node scripts/make-icon.mjs && tauri icon src-tauri/icons/source.png"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/language": "^6.10.8",
    "@codemirror/legacy-modes": "^6.4.2",
    "@codemirror/merge": "~6.10.0",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.5.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.2",
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-dialog": "~2.8.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.12.4",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "~5.8.0",
    "vite": "^7.3.7"
  }
}
