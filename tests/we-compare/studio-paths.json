[
  {
    "name": "studio-paths-rebuilt",
    "description": "test.md 'Maps from paths other than the WE's own save' (1): EchoIsles unpacked, w3proj rebuild --force, packed (make-studio-paths.mjs); the editor opens it and re-saves; Studio's side is the plain open/save/pack",
    "input": {
      "map": "${REPO}/target/studio-paths/echo-rebuilt.w3x"
    },
    "we": {
      "mode": "sd",
      "saveAccept": [
        "Warning"
      ],
      "steps": []
    },
    "studio": {
      "steps": [
        {
          "sleep": 500
        }
      ]
    },
    "compare": [
      {
        "file": "war3map.w3i",
        "as": "parsed",
        "ignore": [
          "version",
          "editorVersion",
          "gameVersion",
          "loadingScreen.crestRace",
          "terrainFog",
          "cameraZoom",
          "water",
          "playerHudSkins",
          "players[].hudSkin"
        ],
        "tolerance": 0.01
      },
      {
        "file": "war3map.doo",
        "as": "parsed",
        "ignore": [
          "version",
          "doodads[].preFlags",
          "doodads[].editorId",
          "doodads[].trailer",
          "doodads[].extras"
        ],
        "tolerance": 0.01
      },
      {
        "file": "war3mapUnits.doo",
        "as": "parsed",
        "ignore": [
          "version",
          "units[].preFlags",
          "units[].trailer",
          "units[].extras"
        ],
        "tolerance": 0.01
      },
      {
        "file": "war3map.wpm",
        "as": "wpm"
      },
      {
        "file": "war3map.w3e",
        "as": "w3e",
        "expect": "differs",
        "expectPaths": [
          "header.version"
        ]
      },
      {
        "file": "war3map.wts",
        "as": "text"
      },
      {
        "file": "war3map.lua",
        "as": "text-set",
        "expect": "differs",
        "expectLines": {
          "we": [
            "^\\s*RandomDistAddItem\\(ChooseRandomItemExWithFilter\\(",
            "^\\s*SetPlayerRaceSkin\\(Player\\(\\d+\\), RACE_PREF_USER_SELECTABLE\\)$",
            "^\\s*SetHDWaterParamsEx\\("
          ],
          "studio": [
            "^\\s*RandomDistAddItem\\(ChooseRandomItemEx\\("
          ]
        }
      }
    ],
    "limit": 12
  },
