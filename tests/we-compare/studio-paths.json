  {
    "name": "studio-paths-terrain-save",
    "description": "(2): Studio's terrain editor moves every selected object (selectAll, Numpad6), saves (editors.saveAll) and packs; the editor opens that map (from: studio) and re-saves; (4) the regenerated war3map.lua of that save",
    "input": {
      "map": "${REPO}/target/studio-paths/echo-plain.w3x"
    },
    "we": {
      "mode": "sd",
      "from": "studio",
      "saveAccept": [
        "Warning"
      ],
      "steps": []
    },
    "studio": {
      "steps": [
        {
          "terrain": true
        },
        {
          "eval": "const s = await w3.services.get('w3.terrain'); for (let i = 0; i < 60 && !s.placedObjects()?.doodads?.length; i++) await new Promise((r) => setTimeout(r, 500)); [...document.querySelectorAll('.terrain-tab')].find((b) => b.textContent === 'Select').click(); await new Promise((r) => setTimeout(r, 1500)); await w3.commands.execute('w3.terrain.selectAll'); await new Promise((r) => setTimeout(r, 500)); const xs = () => (s.placedObjects()?.doodads ?? []).map((d) => d.position[0]); const before = xs(); const c = document.querySelector('.model-stage canvas'); c.focus(); for (const type of ['keydown', 'keyup']) c.dispatchEvent(new KeyboardEvent(type, { key: '6', code: 'Numpad6', bubbles: true })); await new Promise((r) => setTimeout(r, 800)); const after = xs(); const moved = after.filter((x, i) => x > before[i]).length; if (!moved || after.length !== before.length) throw new Error(`Numpad6 moved ${moved} of ${before.length} doodads (now ${after.length})`); await w3.editors.saveAll();"
        },
        {
          "sleep": 2000
        }
      ]
    },
    "compare": [
      {
        "file": "war3map.w3i",
        "as": "parsed",
        "ignore": [
          "version",
          "editorVersion",
          "gameVersion",
          "loadingScreen.crestRace",
          "terrainFog",
          "cameraZoom",
          "water",
          "playerHudSkins",
          "players[].hudSkin"
        ],
        "tolerance": 0.01
      },
      {
        "file": "war3map.doo",
        "as": "parsed",
        "ignore": [
          "version",
          "doodads[].preFlags",
          "doodads[].editorId",
          "doodads[].trailer",
          "doodads[].extras"
        ],
        "tolerance": 0.01
      },
      {
        "file": "war3mapUnits.doo",
        "as": "parsed",
        "ignore": [
          "version",
          "units[].preFlags",
          "units[].trailer",
          "units[].extras"
        ],
        "tolerance": 0.01
      },
      {
        "file": "war3map.wpm",
        "as": "wpm"
      },
      {
        "file": "war3map.w3e",
        "as": "w3e",
        "expect": "differs",
        "expectPaths": [
          "header.version"
        ]
      },
      {
        "file": "war3map.wts",
        "as": "text"
      },
      {
        "file": "war3map.lua",
        "as": "text-set",
        "expect": "differs",
        "expectLines": {
          "we": [
            "^\\s*RandomDistAddItem\\(ChooseRandomItemExWithFilter\\(",
            "^\\s*SetPlayerRaceSkin\\(Player\\(\\d+\\), RACE_PREF_USER_SELECTABLE\\)$",
            "^\\s*SetHDWaterParamsEx\\("
          ],
          "studio": [
            "^\\s*RandomDistAddItem\\(ChooseRandomItemEx\\("
          ]
        }
      }
    ],
    "limit": 12
  },
