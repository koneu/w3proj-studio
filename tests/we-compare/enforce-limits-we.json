          "eval": "const wait = (ms) => new Promise((r) => setTimeout(r, ms)); await w3.commands.execute('w3.mapInfo.open', 'preferences'); let box = null; for (let i = 0; i < 100 && !box; i++) { const b = [...document.querySelectorAll('.map-info .form-body')].find((x) => x.querySelector('h2')?.textContent === 'Preferences'); const l = b && [...b.querySelectorAll('label.form-check')].find((x) => x.textContent.trim() === 'Enforce terrain limits'); box = l?.querySelector('input') ?? null; if (!box) await wait(100); } if (!box) throw new Error('no Enforce terrain limits box'); if (!box.checked) box.click(); await wait(500);"
