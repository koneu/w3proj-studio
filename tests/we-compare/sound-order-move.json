{
  "name": "sound-order-move",
  "description": "Sound Editor's Move Sound Variable Up/Down (Ctrl+Up, Ctrl+Down) against the WE's own save of war3map.w3s. Input sound-order.w3m (make-sound-order-input.mjs): Delta, alpha, Charlie, bravo, Echo with volumes 127, 100, 64, 3, 0. WE (Sound Editor, F5): Echo selected and moved up (above bravo); Delta selected, Up (the first: nothing), Down (below alpha); Ctrl+PgUp twice and Ctrl+PgDn once (the editor's playback volume: no sound has its volume changed, all five keep theirs). Studio: the same by w3.sounds.moveUp/moveDown/volumeUp/volumeDown. Ignored: each sound's file (the editor saves an empty file for a game sound it doesn't find under that name, whatever its extension). Expected MATCH",
  "input": {
    "map": "${REPO}/tests/fixtures/we-compare/sound-order.w3m"
  },
  "we": {
    "mode": "sd",
    "steps": [
      [
        "--key",
        "F5"
      ],
      [
        "--sleep",
        "2000"
      ],
      [
        "--click",
        "428,249"
      ],
      [
        "--key",
        "ctrl+Up"
      ],
      [
        "--sleep",
        "300"
      ],
      [
        "--click",
        "423,193"
      ],
      [
        "--key",
        "ctrl+Up"
      ],
      [
        "--key",
        "ctrl+Down"
      ],
      [
        "--sleep",
        "300"
      ],
      [
        "--key",
        "ctrl+Prior"
      ],
      [
        "--key",
        "ctrl+Prior"
      ],
      [
        "--key",
        "ctrl+Next"
      ],
      [
        "--sleep",
        "300"
      ],
      [
        "--close-modules"
      ]
    ]
  },
  "studio": {
    "steps": [
      {
        "open": "map/war3map.w3s.json"
      },
      {
        "sleep": 500
      },
      {
        "eval": "[...document.querySelectorAll(\"tr.snd-row\")].find((r) => r.firstChild.textContent === \"Echo\").click();"
      },
      {
        "command": "w3.sounds.moveUp"
      },
      {
        "eval": "[...document.querySelectorAll(\"tr.snd-row\")].find((r) => r.firstChild.textContent === \"Delta\").click();"
      },
      {
        "command": "w3.sounds.moveUp"
      },
      {
        "command": "w3.sounds.moveDown"
      },
      {
        "command": "w3.sounds.volumeUp"
      },
      {
        "command": "w3.sounds.volumeUp"
      },
      {
        "command": "w3.sounds.volumeDown"
      }
    ]
  },
  "compare": [
    {
      "file": "war3map.w3s",
      "as": "parsed",
      "ignore": [
        "sounds[].file"
      ]
    }
  ],
  "limit": 30
}
