    { "path": "﻿war3mapImported/x.blp", "archive": "﻿war3mapImported\\x.blp" },
    { "path": "﻿﻿double.txt", "archive": "﻿﻿double.txt" },
    { "path": "a/b﻿.mdx", "archive": "a\\b﻿.mdx" },
    { "path": "100%25.blp", "archive": "100%.blp" },
    { "path": "%25﻿after.txt", "archive": "%﻿after.txt" },
    { "path": "﻿100%25.blp", "archive": "﻿100%.blp" },
    { "path": "a%3Ab%3F.txt", "archive": "a:b?.txt" },
